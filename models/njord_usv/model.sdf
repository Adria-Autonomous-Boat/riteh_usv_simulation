    <!-- Barometer - For PX4 SITL Preflight Check Fix -->

    <link name="barometer_link">
      <pose>0 0 0 0 0 0</pose>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>barometer_link</gz_frame_id>
				<always_on>1</always_on>
				<update_rate>50</update_rate>
				<air_pressure>
					<pressure>
						<noise type="gaussian">
							<mean>0</mean>
							<stddev>0.01</stddev>
						</noise>
					</pressure>
				</air_pressure>
			</sensor>
    </link>

    <joint name="barometer_joint" type="fixed">
      <parent>base_link</parent>
      <child>barometer_link</child>
    </joint>

    <link name="lidar_camera_mount_link">
      <pose>0.279247 -0.011004 0.202049 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000567</ixx>
          <ixy>0</ixy>
          <ixz>-0.000065</ixz>
          <iyy>0.000601</iyy>
          <iyz>0.000001</iyz>
