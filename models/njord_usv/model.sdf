    <link name="lidar_link">
      <pose>0.293147 -0.006652 0.3 3.14159 0 0</pose>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.000123</ixx>
          <ixy>0</ixy>
          <ixz>0.000001</ixz>
          <iyy>0.000133</iyy>
          <iyz>0</iyz>
