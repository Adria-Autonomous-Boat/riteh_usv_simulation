      <sensor name="livox_lidar" type="gpu_lidar">
        <gz_frame_id>lidar_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <pose>0 0 -0.02 0 0 0</pose>
        <ray>
          <visibility_mask>4294967293</visibility_mask>
          <scan>
            <horizontal>
              <samples>1080</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.141593</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.08727</min_angle>
              <max_angle>0.08727</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>
    <link name="right_chasis_link">
