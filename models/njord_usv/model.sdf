    <link name="zed_camera_link">
      <pose>0.345378 0.02 0.2 0 0 0</pose>
      <inertial>
        <mass>0.24</mass>
        <inertia>
          <ixx>0.000056</ixx>
          <ixy>0</ixy>
          <ixz>0.000002</ixz>
          <iyy>0.000503</iyy>
          <iyz>0</iyz>
          <izz>0.000517</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0.004301 0.001346 0.001671 0 0 -1.570796</pose>
        <geometry>
          <mesh>
            <uri>package://usv/models/njord_usv/meshes/zed_camera_link_visual.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.004301 0.001343 0.001671 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://usv/models/njord_usv/meshes/zed_camera_link_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <sensor name="zed_camera" type="camera">
        <gz_frame_id>zed_camera_link_optical</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <pose relative_to="zed_camera_link">0.04 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.919862</horizontal_fov>
          <image>
            <width>960</width>
            <height>600</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="zed_depth_camera" type="depth_camera">
        <gz_frame_id>zed_camera_link_optical</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <pose relative_to="zed_camera_link">0.04 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.919862</horizontal_fov>
          <image>
            <width>960</width>
            <height>600</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>20</far>
          </clip>
        </camera>
        <depth_camera>
          <output>
            <type>depth</type>
          </output>
        </depth_camera>
      </sensor>
    </link>

    <link name="zed_camera_link_optical">
    </link>

    <link name="navsat_link">
      <pose>0.0 0.0 0.1 0 0 0</pose>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>navsat_link</gz_frame_id>
        <pose>0.0 0.0 0.05 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <link name="imu_link">
      <pose>0.0 0.0 0.1 0 0 0</pose>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>


    <joint name="electronics_box_joint" type="fixed">
      <parent>base_link</parent>
      <child>electronics_box_link</child>
    </joint>
    <joint name="left_chasis_engine_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_chasis_link</child>
    </joint>
    <joint name="left_engine_propeller_joint" type="revolute">
      <parent>left_chasis_link</parent>
      <child>left_propeller_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="lidar_camera_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_camera_mount_link</child>
    </joint>
    <joint name="lidar_link_joint" type="fixed">
      <parent>lidar_camera_mount_link</parent>
      <child>lidar_link</child>
    </joint>
    <joint name="right_chasis_link_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_chasis_link</child>
    </joint>
    <joint name="right_engine_propeller_joint" type="revolute">
      <parent>right_chasis_link</parent>
      <child>right_propeller_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="zed_camera_link_joint" type="fixed">
      <parent>lidar_camera_mount_link</parent>
      <child>zed_camera_link</child>
    </joint>
    <joint name="zed_camera_link_optical_joint" type="fixed">
      <pose>0.345378 0.02 0.2 -1.570796 0 -1.570796</pose>
      <parent>zed_camera_link</parent>
      <child>zed_camera_link_optical</child>
    </joint>
    <joint name="navsat_joint" type="fixed">
      <parent>base_link</parent>
      <child>navsat_link</child>
    </joint>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.19</hull_length>
      <hull_radius>0.105</hull_radius>
      <fluid_level>0.10</fluid_level>
      <points>
        <point>0.34 0.42 0.0</point>
        <point>-0.34 0.42 0.0</point>
      </points>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.19</hull_length>
      <hull_radius>0.105</hull_radius>
      <fluid_level>0.10</fluid_level>
      <points>
        <point>0.34 -0.42 0.0</point>
        <point>-0.34 -0.42 0.0</point>
      </points>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>

    <plugin
      filename="libSimpleHydrodynamics.so"
      name="vrx::SimpleHydrodynamics">
      <link_name>base_link</link_name>
      <!-- Added mass -->
      <xDotU>6.5</xDotU>
      <yDotV>10.0</yDotV>
      <nDotR>1.5</nDotR>

      <!-- Linear and quadratic drag -->
      <xU>22.0</xU>
      <xUU>34.0</xUU>
      <yV>30.0</yV>
      <yVV>48.0</yVV>
      <zW>36.0</zW>
      <kP>18.0</kP>
      <kPP>34.0</kPP>
      <mQ>46.0</mQ>
      <mQQ>58.0</mQQ>
      <nR>48.0</nR>
      <nRR>56.0</nRR>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <joint_name>left_engine_propeller_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1145</propeller_diameter>
      <velocity_control>false</velocity_control>
      <thrust_coefficient>0.0045</thrust_coefficient>
      <max_thrust_cmd>158</max_thrust_cmd>
      <min_thrust_cmd>-103</min_thrust_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <joint_name>right_engine_propeller_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1145</propeller_diameter>
      <velocity_control>false</velocity_control>
      <thrust_coefficient>-0.0045</thrust_coefficient>
      <max_thrust_cmd>158</max_thrust_cmd>
      <min_thrust_cmd>-103</min_thrust_cmd>
    </plugin>
  </model>
</sdf>
